  "author": "Giovanni Fiore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfiore88/agentic-repo-kit.git"
  },
  "homepage": "https://github.com/gfiore88/agentic-repo-kit#readme",
  "bugs": {
    "url": "https://github.com/gfiore88/agentic-repo-kit/issues"
  },
  "keywords": [
    "ai",
    "agentic",
    "coding-agents",
    "claude-code",
    "codex",
    "github-copilot",
    "antigravity",
    "cursor",
    "gemini-cli",
    "opencode",
    "kiro",
    "knowledge-base",
    "llm-wiki",
    "adr",
    "prd",
    "developer-tools",
    "scaffolding",
    "governance",
    "self-annealing"
  ],
  "files": [
    "bin/",
    "plugins/agentic-repo/"
  ],
  "description": "Model-agnostic, multi-runtime scaffolding for governed AI-native repositories.",
  "type": "module",
  "bin": {
    "agentic-repo": "bin/agentic-repo.mjs"
  },
  "scripts": {
    "test": "node --test",
    "validate:plugin": "node ./scripts/validate-plugin.mjs",
    "validate:skills": "node ./scripts/validate-skills.mjs",
    "validate": "npm test && npm run validate:skills && npm run validate:plugin",
    "prepublishOnly": "npm run validate"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  }
}
